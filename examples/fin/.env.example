# FinAlly — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.

# --- LLM (required for the AI chat panel) ---------------------------------
# OpenRouter API key. Get one at https://openrouter.ai/keys
# Absent or empty: the app runs fine, but /api/chat returns 503.
OPENROUTER_API_KEY=

# Model id passed to OpenRouter verbatim, e.g. openai/gpt-oss-120b.
# There is deliberately NO default: an unset value returns 503 naming this
# variable rather than silently billing you for a model you did not choose.
OPENROUTER_MODEL=openai/gpt-oss-120b

# --- Market data ----------------------------------------------------------
# Massive (Polygon.io) key for real market data.
# Empty  -> the built-in GBM simulator is used (recommended, and the default).
# Set    -> the Massive REST poller is used, with NO fallback to the simulator:
#           a bad key means visibly stale prices and loud logs, never plausible
#           fake ones presented as real.
MASSIVE_API_KEY=

# Poll interval in seconds for the Massive source. Free tier is 5 calls/min,
# so 15 is the safe floor there; paid tiers support 2-15.
#
# Clamped, and loudly: anything below 2 is raised to 2, and a non-finite value
# (inf, nan) falls back to 15. Unclamped, 0 was a hot loop against a metered
# API, inf froze prices forever in silence, and nan restarted the price
# producer on every tick.
MASSIVE_POLL_SECONDS=15

# --- Networking -----------------------------------------------------------
# Comma-separated hosts this app will answer for. Unset means
# localhost,127.0.0.1,[::1] — which is what stops a malicious page from using
# DNS rebinding to talk to your portfolio from the browser you have open.
# Widen it only if you serve the app under another name.
ALLOWED_HOSTS=

# --- Testing --------------------------------------------------------------
# "true" returns deterministic mock LLM responses and makes no network calls.
# The E2E suite sets this itself; set it locally to develop without spending
# credits.
LLM_MOCK=false
